<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ejs</title>
</head>
<body>

    <h1>Company List</h1>

    <a href="/add">Add Company</a>

    <ul>
        <% company.forEach((c) => { %>

        <li>
            <%= c.name %>

            <a href="/delete/<%= c.id %>">Delete</a>

            <a href="/edit/<%= c.id %>">Edit</a>
        </li>

        <% }) %>
    </ul>

</body>
</html>